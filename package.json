{
  "name": "tecmogeek",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "pnpm run build && wrangler deploy --profile personal",
    "deploy:check": "pnpm run build && wrangler deploy --dry-run",
    "rebuild:offense": "node scripts/rebuild-offensive-ratings.mjs",
    "rebuild:defense": "node scripts/rebuild-defensive-ratings.mjs",
    "rebuild:team-ratings": "node scripts/rebuild-team-ratings.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify:team-components": "node scripts/verify-team-components.mjs",
    "verify:team-rankings": "node scripts/verify-team-rankings.mjs",
    "verify:rankings": "node scripts/verify-rankings.mjs",
    "verify:player-sorting": "node scripts/verify-player-sorting.mjs",
    "verify:routes": "playwright test routes.spec.ts",
    "verify:rebuilds": "node scripts/verify-rebuilds.mjs",
    "verify:about-ratings": "playwright test about-ratings.spec.mjs",
    "verify:attributes": "playwright test attributes.spec.ts",
    "verify:portraits": "playwright test portraits.spec.ts",
    "verify:players": "node scripts/verify-players.mjs",
    "verify:offense": "node scripts/verify-offense.mjs",
    "verify:defense": "node scripts/verify-defense.mjs",
    "verify:lineups": "node scripts/verify-lineups.mjs"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "serve": "^14.2.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "8.0.11",
    "vitest": "^4.1.5",
    "wrangler": "^4.129.0",
    "z3-solver": "^5.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ],
    "overrides": {
      "minimatch@3.1.5>brace-expansion": "1.1.14",
      "next>postcss": "8.5.14",
      "vite": "8.0.11"
    }
  }
}
